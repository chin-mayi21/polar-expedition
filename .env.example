# Local dev (default)
DATABASE_URL="file:./dev.db"

# Render / Vercel production — use PostgreSQL (Neon or Render Postgres)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
AUTH_SECRET="generate-a-long-random-string"

# Local dev (optional; default is fine on :3000). Do NOT use port 10000 locally.
# AUTH_URL="http://localhost:3000"

# Render production: public URL only — never http://localhost:10000 (that breaks login redirects)
# AUTH_URL="https://cryolink-bk00.onrender.com"

# Optional — Google OAuth (Console: authorized redirect http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
